# Copy to apps/storefront/.env and apps/admin/.env (and packages/db/.env for drizzle-kit)
DATABASE_URL=mysql://acharkuthi:acharkuthi@127.0.0.1:3306/acharkuthi
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# From the "web" OAuth client JSON: client_id / client_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin: storefront origin for product photos
STOREFRONT_URL=http://localhost:3000

# Cloudflare R2 for product photo uploads (admin). Leave empty to disable uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket address, e.g. https://img.acharkuthi.com
R2_PUBLIC_URL=

# Shop email over SMTP (admin restock reminders, storefront password-reset links).
# Hostinger: smtp.hostinger.com, port 465. Needed in production for password resets.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "আচারকুঠি <shop@acharkuthi.com>" (defaults to SMTP_USER)
MAIL_FROM=

# Admin only, production: first owner account, created on start when no owner exists.
# Remove after the first sign-in.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=

# Storefront only: Meta (Facebook) Pixel ID from Events Manager. Leave empty to keep the pixel off.
META_PIXEL_ID=

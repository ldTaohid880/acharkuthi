{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "storefront-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@acharkuthi/storefront",
        "exec",
        "next",
        "dev",
        "--port",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "storefront-existing",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@acharkuthi/admin",
        "dev"
      ],
      "port": 3001
    }
  ]
}

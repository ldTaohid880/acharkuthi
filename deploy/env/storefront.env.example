# Hostinger environment variables for acharkuthi.store.
# Copy to deploy/env/storefront.env (git-ignored), fill in, then:
#   pnpm deploy:env storefront deploy/env/storefront.env --yes
# This REPLACES the whole set on Hostinger: keys missing here are deleted there.

# Hostinger MySQL from inside Hostinger
DATABASE_URL=mysql://user:password@127.0.0.1:3306/prod

# openssl rand -base64 32 (keep it; changing it signs everyone out)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://acharkuthi.store

# Google OAuth "web" client. Authorised redirect URI:
#   https://acharkuthi.store/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Review photos (same R2 bucket and keys as the admin)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acharkuthi
R2_PUBLIC_URL=https://pub-53e1c4fede854e729a7e646707b9a016.r2.dev

# Password-reset emails (Hostinger mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

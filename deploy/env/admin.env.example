# Hostinger environment variables for admin.acharkuthi.store.
# Copy to deploy/env/admin.env (git-ignored), fill in, then:
#   pnpm deploy:env admin deploy/env/admin.env --yes
# This REPLACES the whole set on Hostinger: keys missing here are deleted there.

DATABASE_URL=mysql://u225292959_acharkuthiroot:PASSWORD@127.0.0.1:3306/u225292959_prod

# Its own secret (the admin keeps separate sessions from the shop)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://admin.acharkuthi.store

# Google OAuth client. Authorised redirect URI:
#   https://admin.acharkuthi.store/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STOREFRONT_URL=https://acharkuthi.store

# Product photos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acharkuthi
R2_PUBLIC_URL=https://pub-53e1c4fede854e729a7e646707b9a016.r2.dev

# Restock reminders
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# First owner account: created on start when no owner exists yet. Remove both after the first
# sign-in (pnpm deploy:env admin … again without them).
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
